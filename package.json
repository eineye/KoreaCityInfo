    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1"
  }
}
